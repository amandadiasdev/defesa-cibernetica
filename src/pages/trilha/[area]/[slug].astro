---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import Tag from '../../../components/Tag.astro';
import Button from '../../../components/Button.astro';
import { areaById, splitTrilhaId } from '../../../data/areas';
import { url } from '../../../lib/url';

export async function getStaticPaths() {
  const todos = await getCollection('trilha');
  const paths = [];
  for (const areaId of new Set(todos.map((d) => d.data.area))) {
    const degraus = todos.filter((d) => d.data.area === areaId).sort((a, b) => a.data.ordem - b.data.ordem);
    degraus.forEach((d, i) => {
      paths.push({
        params: { area: areaId, slug: splitTrilhaId(d.id).slug },
        props: { entry: d, prev: degraus[i - 1] ?? null, next: degraus[i + 1] ?? null, total: degraus.length },
      });
    });
  }
  return paths;
}

const { entry, prev, next, total } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const area = areaById(d.area);
const link = (e: typeof entry) => `/trilha/${e.data.area}/${splitTrilhaId(e.id).slug}/`;
---

<Base title={`Degrau ${d.ordem} · ${d.titulo}`} description={d.resumo}>
  <section class="section">
    <div class="container trail">
      <aside class="trail__aside">
        <p class="eyebrow">Trilha de {area?.nome.toLowerCase()} · degrau {d.ordem} de {total}</p>
        <ol class="trail__progress" aria-label="Progresso na trilha">
          {Array.from({ length: total }, (_, i) => (
            <li class:list={['trail__dot', { 'trail__dot--done': i + 1 < d.ordem, 'trail__dot--now': i + 1 === d.ordem }]} aria-current={i + 1 === d.ordem ? 'step' : undefined}>{i + 1}</li>
          ))}
        </ol>
        <dl class="trail__meta">
          <dt>Pergunta</dt>
          <dd>{d.pergunta}</dd>
          {d.prerequisitos.length > 0 && (
            <>
              <dt>Antes deste</dt>
              <dd>{d.prerequisitos.join(', ')}</dd>
            </>
          )}
          {d.tempo && (
            <>
              <dt>Tempo estimado</dt>
              <dd>{d.tempo}</dd>
            </>
          )}
          <dt>Ao terminar, você consegue</dt>
          <dd>{d.resultado}</dd>
        </dl>
        <div class="cluster">
          {d.tags.map((t) => <Tag>{t}</Tag>)}
        </div>
      </aside>

      <article class="trail__content">
        <SectionHeading level="h1" eyebrow={`${area?.nome} · Degrau ${d.ordem}`} title={d.titulo} lead={d.resumo} />
        <div class="markdown prose">
          <Content />
        </div>
        <nav class="trail__nav" aria-label="Navegação da trilha">
          {prev ? (
            <Button href={link(prev)} variant="secondary">← Degrau {prev.data.ordem}</Button>
          ) : (
            <Button href={`/bolsistas/${d.area}/#trilha`} variant="secondary">← Início da trilha</Button>
          )}
          {next ? (
            <Button href={link(next)} variant="primary">Degrau {next.data.ordem} →</Button>
          ) : (
            <Button href={`/bolsistas/${d.area}/#atuais`} variant="primary">Ver os bolsistas →</Button>
          )}
        </nav>
        <p class="caption" style="margin-top: var(--space-4)">
          Termos em destaque estão no <a href={url('/bolsistas/#glossario')}>glossário</a>.
        </p>
      </article>
    </div>
  </section>
</Base>

<style>
  .trail {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: var(--space-7);
    align-items: start;
  }
  .trail__aside {
    position: sticky;
    top: 88px;
    padding: var(--space-4);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-default);
    font-size: calc(var(--text-body) - 2px);
  }
  .trail__progress {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4);
    display: flex;
    gap: var(--space-2);
  }
  .trail__dot {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 2px solid var(--color-border-card);
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
  }
  .trail__dot--done {
    background: var(--color-border-card);
    color: var(--color-bg-page);
  }
  .trail__dot--now {
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
    border-color: var(--color-tag-bg);
  }
  .trail__meta {
    margin: 0 0 var(--space-3);
  }
  .trail__meta dt {
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
    margin-top: var(--space-2);
  }
  .trail__meta dd {
    margin: 0;
  }
  .trail__nav {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-soft);
  }
  @media (max-width: 899px) {
    .trail {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .trail__aside {
      position: static;
    }
  }
</style>
