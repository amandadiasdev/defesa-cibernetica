---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import EmailCopy from '../components/EmailCopy.astro';
import { professor, sources } from '../data/professor';
---

<Base title="Contato" description="Como falar com o professor Silvio Quincozes: e-mail institucional e sala no campus Alegrete da Unipampa.">
  <section class="section">
    <div class="container">
      <SectionHeading level="h1" eyebrow="Contato" title="Como falar com o professor" lead="E-mail para assuntos acadêmicos e sala para atendimento presencial. Para marcar uma reunião, escreva por e-mail." />
      <div class="grid grid--2">
        <Card title="E-mail">
          <EmailCopy email={professor.email.valor} />
          <p class="caption">Use o e-mail institucional para orientação, disciplinas e propostas de pesquisa.</p>
        </Card>
        <Card title="Presencial">
          <p>{professor.sala.valor}</p>
          <p>Unipampa · {professor.campus.valor}</p>
          <p class="caption">Horário de atendimento: combine pelo chat institucional ou por e-mail.</p>
        </Card>
      </div>
    </div>
  </section>

  <section class="section section--band">
    <div class="container">
      <SectionHeading title="Perfis" lead="Publicações, currículo e redes." />
      <div class="cluster">
        {professor.perfis.map((p) => (
          <Button href={p.url} variant="secondary">{p.nome}</Button>
        ))}
      </div>
    </div>
  </section>
</Base>
