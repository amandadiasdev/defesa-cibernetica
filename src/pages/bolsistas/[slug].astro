---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Tag from '../../components/Tag.astro';
import Button from '../../components/Button.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const bolsistas = await getCollection('bolsistas');
  return bolsistas.map((b) => ({ params: { slug: b.id }, props: { entry: b } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={d.nome} description={`${d.nome}, ${d.nivel.toLowerCase()} no projeto XAIID: ${d.tema}`}>
  <section class="section">
    <div class="container">
      <p><a href={url('/bolsistas/')}>← Bolsistas</a></p>
      <SectionHeading level="h1" eyebrow={`${d.nivel} · ${d.status === 'atual' ? 'bolsista atual' : 'egresso'}`} title={d.nome} lead={d.tema} />
      <div class="cluster">
        {d.tags.map((t) => <Tag>{t}</Tag>)}
      </div>

      <dl class="card-fields">
        {d.pergunta && (
          <div>
            <dt>Pergunta de pesquisa</dt>
            <dd>{d.pergunta}</dd>
          </div>
        )}
        {d.inicio && (
          <div>
            <dt>Início</dt>
            <dd>{d.inicio}</dd>
          </div>
        )}
        {d.degrau && (
          <div>
            <dt>Na trilha</dt>
            <dd>Degrau {d.degrau}</dd>
          </div>
        )}
        {d.repositorio && (
          <div>
            <dt>Repositório</dt>
            <dd>
              <a href={d.repositorio.url} rel="noopener">{d.repositorio.url.replace(/^https?:\/\//, '')}</a>
              {d.repositorio.privado && <span class="caption"> (privado: acesso pelo grupo)</span>}
            </dd>
          </div>
        )}
      </dl>

      <div class="markdown prose">
        <Content />
      </div>

      <div class="cluster" style="margin-top: var(--space-5)">
        <Button href="/bolsistas/" variant="secondary">Todos os bolsistas</Button>
        <Button href="/sistemas/" variant="link">Sistemas e repositórios</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .card-fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-3);
    margin: var(--space-4) 0 var(--space-5);
    max-width: var(--container);
  }
  .card-fields > div {
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-default);
  }
  .card-fields dt {
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
    margin-bottom: 2px;
  }
  .card-fields dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
</style>
