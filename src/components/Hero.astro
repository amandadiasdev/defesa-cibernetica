---
import { url } from '../lib/url';
import Button from './Button.astro';
import { useTranslations } from '../i18n/ui';
import { grupo } from '../data/grupo';

const t = useTranslations('pt-BR');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__text">
      <ul class="hero__badges" aria-label="Instituições">
        <li class="hero__kicker">Desde {grupo.desde}</li>
        {grupo.instituicoes.map((i) => <li class="hero__kicker">{i}</li>)}
      </ul>
      <h1 id="hero-title">{grupo.nome}</h1>
      <p class="hero__tagline">{grupo.tagline}</p>
      <p class="hero__lead">{grupo.descricaoCurta}</p>
      <div class="hero__actions">
        <Button href="/projetos/" variant="primary" onDark>{t('cta.research')}</Button>
        <Button href="/bolsistas/" variant="secondary" onDark>{t('cta.students')}</Button>
      </div>
    </div>
    <div class="hero__logo">
      <img src={url('/logo-dc.png')} width="300" height="300" alt={`Logo do grupo ${grupo.nome}`} loading="eager" decoding="async" />
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--color-bg-hero);
    color: var(--color-text-on-dark);
    padding-block: var(--space-8);
    border-bottom: 2px solid var(--color-accent-on-dark);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-7);
  }
  .hero__badges {
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .hero__kicker {
    display: inline-block;
    padding: 4px 12px;
    border-radius: var(--radius-small);
    background: var(--color-accent-on-dark);
    color: #111111;
    font-weight: 600;
    font-size: 13px;
  }
  .hero h1 {
    color: inherit;
    margin-bottom: var(--space-2);
  }
  .hero__tagline {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    color: var(--color-accent-on-dark);
    max-width: 640px;
  }
  .hero__lead {
    max-width: 640px;
    margin-bottom: var(--space-4);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .hero__logo img {
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: #ffffff;
    object-fit: contain;
    padding: 16px;
    border: 4px solid var(--color-accent-on-dark);
    box-shadow: 0 0 0 12px rgba(192, 156, 72, 0.12);
  }

  @media (max-width: 899px) {
    .hero {
      padding-block: var(--space-6);
    }
    .hero__inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--space-4);
    }
    .hero__logo {
      order: -1;
      justify-self: center;
    }
    .hero__logo img {
      width: 160px;
      height: 160px;
      padding: 10px;
    }
    .hero__tagline,
    .hero__lead {
      margin-inline: auto;
    }
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero__badges {
      justify-content: center;
    }
  }
</style>
