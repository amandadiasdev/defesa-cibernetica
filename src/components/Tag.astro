---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['tag', className]}><slot /></span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border-radius: var(--radius-small);
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 13px;
    line-height: 1.3;
    white-space: nowrap;
  }
</style>
