---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Placeholder from '../components/Placeholder.astro';
import Button from '../components/Button.astro';
import EmailCopy from '../components/EmailCopy.astro';
import { professor } from '../data/professor';
import { grupo } from '../data/grupo';
import { url } from '../lib/url';

const titulos = ['Doutor em Ciência da Computação · UFF', 'Mestre em Ciência da Computação · UFSM', 'Professor · Unipampa'];
---

<Base title="Perfil" description={`Perfil de ${professor.nome}, coordenador do grupo ${grupo.nome}: formação, atuação, ensino e áreas de pesquisa.`}>
  <section class="section profile">
    <div class="container profile__grid">
      <aside class="profile__aside">
        <img class="profile__photo" src={url('/foto-silvio.jpeg')} width="240" height="240" alt={`Foto de ${professor.nome}`} loading="eager" />
        <p class="eyebrow">Coordenador do grupo</p>
        <h1 class="profile__name">{professor.nome}</h1>
        <ul class="profile__titles">
          {titulos.map((t) => <li>{t}</li>)}
        </ul>
        <dl class="profile__facts">
          <dt>Instituição</dt>
          <dd>Unipampa · {professor.campus.valor}</dd>
          <dt>Sala</dt>
          <dd>{professor.sala.valor}</dd>
          <dt>E-mail</dt>
          <dd><EmailCopy email={professor.email.valor} /></dd>
        </dl>
        <div class="profile__links">
          {professor.perfis.map((p) => (
            <a href={p.url} rel="noopener">{p.nome}</a>
          ))}
        </div>
      </aside>

      <div class="profile__main">
        <section class="profile__block" aria-labelledby="resumo">
          <h2 id="resumo">Atuação</h2>
          <p class="prose">
            {professor.coordenacao.valor} e docente do {professor.posGraduacao[1].nome} ({professor.posGraduacao[1].sigla}, UFU).
            Coordena o grupo {grupo.nome} e orienta mestrandos, bolsistas de iniciação científica e de extensão e trabalhos de conclusão de curso.
          </p>
          <p class="prose">{professor.pesquisa.resumo}</p>
          <ul class="profile__list">
            <li><strong>Áreas:</strong> {professor.areas.map((a) => a.nome).join('; ')}.</li>
            <li><strong>Parcerias:</strong> {professor.parcerias.valor.join(', ')}.</li>
          </ul>
        </section>

        <section class="profile__block" aria-labelledby="formacao">
          <h2 id="formacao">Formação</h2>
          <ol class="timeline">
            {professor.formacao.map((f) => (
              <li class="timeline__item">
                <span class="timeline__year"><Placeholder value={f.ano} /></span>
                <div>
                  <p class="timeline__title">{f.titulo}</p>
                  <p class="timeline__inst">{f.instituicao}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <section class="profile__block" aria-labelledby="ensino">
          <h2 id="ensino">Ensino</h2>
          <ul class="profile__list">
            <li><strong>Graduação (Unipampa):</strong> {professor.disciplinas.map((d) => d.nome).join('; ')}.</li>
            {professor.posGraduacao.map((p) => (
              <li><strong>{p.sigla} · {p.instituicao}:</strong> {p.nome}, orientação de mestrado e doutorado.</li>
            ))}
          </ul>
        </section>

        <section class="profile__block" aria-labelledby="numeros">
          <h2 id="numeros">Publicações</h2>
          <dl class="stats">
            <div class="stats__item">
              <dt>Citações</dt>
              <dd>{professor.metricasScholar.citacoes}</dd>
            </div>
            <div class="stats__item">
              <dt>Índice h</dt>
              <dd>{professor.metricasScholar.indiceH}</dd>
            </div>
          </dl>
          <p class="caption">Google Scholar, {professor.metricasScholar.data}.</p>
          <div class="cluster">
            <Button href="/publicacoes/" variant="primary">Trabalhos em destaque</Button>
            <Button href="/projetos/" variant="secondary">Projetos do grupo</Button>
          </div>
        </section>
      </div>
    </div>
  </section>
</Base>

<style>
  .profile__grid {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: var(--space-7);
    align-items: start;
  }
  .profile__aside {
    position: sticky;
    top: 88px;
    padding: var(--space-5);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-default);
  }
  .profile__photo {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--color-accent-on-dark);
    margin-bottom: var(--space-4);
  }
  .profile__name {
    font-size: var(--text-h2);
    line-height: var(--leading-h2);
    margin-bottom: var(--space-3);
  }
  .profile__titles {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: grid;
    gap: var(--space-1);
    font-size: calc(var(--text-body) - 2px);
    color: var(--color-text-secondary);
  }
  .profile__titles li::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent-on-dark);
    margin-right: var(--space-2);
    vertical-align: middle;
  }
  .profile__facts {
    margin: 0 0 var(--space-4);
    display: grid;
    gap: var(--space-1);
    font-size: calc(var(--text-body) - 2px);
  }
  .profile__facts dt {
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
    margin-top: var(--space-2);
  }
  .profile__facts dd {
    margin: 0;
  }
  .profile__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    font-size: calc(var(--text-body) - 2px);
  }
  .profile__main {
    display: grid;
    gap: var(--space-6);
  }
  .profile__block h2 {
    margin-bottom: var(--space-3);
  }
  .profile__list {
    padding-left: 1.2em;
    max-width: var(--measure);
  }
  .profile__list li + li {
    margin-top: var(--space-2);
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
  }
  .timeline__item {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border-soft);
  }
  .timeline__year {
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    font-size: var(--text-h3);
    line-height: 1.2;
  }
  .timeline__title {
    font-weight: 600;
    margin-bottom: 2px;
  }
  .timeline__inst {
    margin: 0;
    color: var(--color-text-secondary);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 200px));
    gap: var(--space-3);
    margin: 0 0 var(--space-2);
  }
  .stats__item {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-default);
    background: var(--color-bg-card);
  }
  .stats__item dt {
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
  }
  .stats__item dd {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    font-size: var(--text-h1);
    line-height: 1.1;
  }
  .profile__block .cluster {
    margin-top: var(--space-3);
  }
  @media (max-width: 899px) {
    .profile__grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .profile__aside {
      position: static;
    }
    .stats {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
