---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
import Tag from '../components/Tag.astro';
import Button from '../components/Button.astro';
import Quote from '../components/Quote.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { useTranslations } from '../i18n/ui';
import { professor, sources } from '../data/professor';
import { url } from '../lib/url';
import { areas } from '../data/areas';
import { grupo, projetos } from '../data/grupo';

const t = useTranslations('pt-BR');
const trilha = await getCollection('trilha');
const bolsistas = (await getCollection('bolsistas')).filter((b) => b.data.status === 'atual');

const portas = [
  {
    tag: t('label.new'),
    title: 'Orientando novo',
    href: '/bolsistas/',
    linkLabel: t('cta.startTrail'),
    text: 'Trilhas de estudo por área (pesquisa, extensão e outros programas), do conceito geral até o seu tema, com glossário.',
  },
  {
    tag: t('label.current'),
    title: 'Quem já está no grupo',
    href: '/sistemas/',
    linkLabel: t('cta.openSystems'),
    text: 'Codefólio, repositórios, datasets e ferramentas em um só lugar.',
  },
  {
    tag: t('label.external'),
    title: 'Visitante',
    href: '/projetos/',
    linkLabel: t('cta.research'),
    text: 'O que o grupo pesquisa, projetos em andamento, publicações e como entrar em contato.',
  },
];
const emDestaque = projetos.filter((p) => p.status !== 'a confirmar');
---

<Base
  title="Início"
  description="Defesa Cibernética: grupo de pesquisa em cibersegurança e inteligência artificial aplicada (Unipampa, UFU, UFSM). Projetos, orientandos, publicações e trilhas de estudo."
  isHome
>
  <Hero />

  <section class="section" aria-labelledby="portas">
    <div class="container">
      <SectionHeading id="portas" title="Por onde começar" lead="Três públicos, três portas. Escolha a sua." />
      <div class="grid grid--3">
        {portas.map((p) => (
          <Card title={p.title} href={p.href} tag={p.tag} linkLabel={p.linkLabel}>
            <p>{p.text}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--band" aria-labelledby="pesquisa">
    <div class="container research">
      <div class="research__text">
        <SectionHeading id="pesquisa" eyebrow="Pesquisa e extensão" title="O que o grupo pesquisa" />
        <p class="prose">{professor.pesquisa.resumo}</p>
        <p class="prose">{professor.extensao.resumo}</p>
        <p class="prose">{grupo.laboratorio.descricao} A página Projetos detalha temas, projetos e trabalhos publicados.</p>
        <div class="cluster" aria-label="Temas">
          {['Cibersegurança', 'IA aplicada', 'Detecção de intrusão', 'XAI', 'LLMs', 'Educação 5.0', 'Engenharia de software', 'Extensão'].map((c) => <Tag>{c}</Tag>)}
        </div>
        <div class="research__actions">
          <Button href="/projetos/" variant="primary">{t('cta.research')}</Button>
          <Button href={sources.scholar.url} variant="link">{t('cta.scholar')}</Button>
        </div>
      </div>
      <Quote cite="Quincozes et al., 2023 · Google Scholar" href={sources.scholar.url}>
        O ERENO gera conjuntos de dados realistas de detecção de intrusão para redes IEC 61850 em subestações digitais, com cenários normais e de ataque.
      </Quote>
    </div>
  </section>

  <section class="section" aria-labelledby="projetos">
    <div class="container">
      <SectionHeading id="projetos" eyebrow="Em andamento" title="Projetos" lead="Os projetos que organizam o trabalho do grupo hoje." />
      <div class="grid grid--2">
        {emDestaque.map((p) => (
          <Card title={`${p.sigla} · ${p.titulo}`} href="/projetos/#projetos" tag={p.agencia} linkLabel="Ver projeto">
            <p>{p.resumo.replace(/ Título oficial.*$/, '')}</p>
            <p class="cluster">{p.temas.map((tg) => <Tag>{tg}</Tag>)}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--band" aria-labelledby="coord">
    <div class="container coord">
      <img class="coord__photo" src={url('/foto-silvio.jpeg')} width="200" height="200" alt={`Foto de ${professor.nome}`} loading="lazy" />
      <div>
        <SectionHeading id="coord" eyebrow="Coordenação" title={professor.nome} lead={`${professor.coordenacao.curto} e docente do PPGCO (UFU). Orienta mestrandos, bolsistas de iniciação científica e de extensão e trabalhos de conclusão de curso.`} />
        <div class="cluster">
          <Button href="/perfil/" variant="primary">{t('cta.profile')}</Button>
          <Button href="/contato/" variant="secondary">{t('cta.contact')}</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="areas">
    <div class="container">
      <SectionHeading
        id="areas"
        eyebrow="Para quem está chegando"
        title="Três áreas, três trilhas"
        lead="Pesquisa, extensão e outros programas. Cada área tem uma trilha em degraus: cada degrau responde uma pergunta que o seguinte precisa."
      />
      <ol class="steps">
        {areas.map((a, i) => {
          const n = trilha.filter((d) => d.data.area === a.id).length;
          return (
            <li class="steps__item">
              <a class="steps__link" href={url(`/bolsistas/${a.id}/`)}>
                <span class="steps__num" aria-hidden="true">{i + 1}</span>
                <span class="steps__body">
                  <span class="steps__title">{a.nome}</span>
                  <span class="steps__q">{a.papel} {a.emConstrucao ? '· trilha em construção' : `· ${n} degraus`}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="grupo">
    <div class="container">
      <SectionHeading id="grupo" title="Orientandos" lead="Mestrandos no PPGES (Unipampa) e no PPGCO (UFU), bolsistas de iniciação científica e de extensão, e trabalhos de conclusão de curso, organizados por área." />
      <div class="grid grid--3">
        {areas.map((a) => {
          const n = bolsistas.filter((b) => b.data.area === a.id).length;
          return (
            <Card title={a.nome} href={`/bolsistas/${a.id}/`} tag={n > 0 ? `${n} ${n === 1 ? 'pessoa' : 'pessoas'}` : undefined} linkLabel="Ver orientandos">
              <p>{a.papel}</p>
            </Card>
          );
        })}
      </div>
    </div>
  </section>
</Base>

<style>
  .coord {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
  }
  .coord__photo {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--color-accent-on-dark);
  }
  @media (max-width: 767px) {
    .coord {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
  }
  .research {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--space-6);
    align-items: start;
  }
  .research__text .cluster {
    margin: var(--space-3) 0 var(--space-4);
  }
  .research__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .steps__link {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-default);
    background: var(--color-bg-card);
    color: var(--color-text-primary);
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }
  .steps__link:hover {
    transform: translateX(4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    color: var(--color-text-primary);
  }
  .steps__num {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    font-size: var(--text-h3);
  }
  .steps__body {
    display: grid;
    gap: 2px;
  }
  .steps__title {
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    font-size: calc(var(--text-body) + 2px);
  }
  .steps__q {
    color: var(--color-text-secondary);
    font-size: calc(var(--text-body) - 2px);
  }
  @media (max-width: 899px) {
    .research {
      grid-template-columns: 1fr;
    }
  }
</style>
