---
/**
 * Mostra um e-mail como texto selecionável, com botão "Copiar" e um link
 * mailto: secundário. Evita depender de aplicativo de e-mail instalado.
 */
interface Props {
  email: string;
}
const { email } = Astro.props;
---

<div class="email-copy" data-email-copy>
  <code class="email-copy__address" data-email-text>{email}</code>
  <div class="email-copy__actions">
    <button class="email-copy__btn" type="button" data-email-btn>Copiar e-mail</button>
    <a class="email-copy__link" href={`mailto:${email}`}>Abrir no aplicativo de e-mail</a>
  </div>
  <p class="email-copy__status" role="status" aria-live="polite" data-email-status></p>
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-email-copy]')) {
    const btn = box.querySelector<HTMLButtonElement>('[data-email-btn]');
    const text = box.querySelector<HTMLElement>('[data-email-text]');
    const status = box.querySelector<HTMLElement>('[data-email-status]');
    btn?.addEventListener('click', async () => {
      const value = text?.textContent?.trim() ?? '';
      try {
        await navigator.clipboard.writeText(value);
        if (status) status.textContent = 'E-mail copiado.';
      } catch {
        const range = document.createRange();
        if (text) {
          range.selectNodeContents(text);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
        }
        if (status) status.textContent = 'Selecionado: use Ctrl+C para copiar.';
      }
      window.setTimeout(() => {
        if (status) status.textContent = '';
      }, 4000);
    });
  }
</script>

<style>
  .email-copy {
    display: grid;
    gap: var(--space-2);
  }
  .email-copy__address {
    font-size: calc(var(--text-body) - 1px);
    padding: var(--space-2) var(--space-3);
    user-select: all;
    overflow-wrap: anywhere;
  }
  .email-copy__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  .email-copy__btn {
    min-height: 40px;
    padding: 8px 20px;
    border-radius: var(--radius-button);
    border: 2px solid var(--color-button-primary-bg);
    background: var(--color-button-primary-bg);
    color: var(--color-button-primary-text);
    font: inherit;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
  }
  .email-copy__btn:hover {
    background: var(--color-button-primary-hover);
    border-color: var(--color-button-primary-hover);
  }
  .email-copy__link {
    font-size: var(--text-caption);
  }
  .email-copy__status {
    margin: 0;
    min-height: 1.4em;
    font-size: var(--text-caption);
    color: var(--color-success-text);
  }
</style>
