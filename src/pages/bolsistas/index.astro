---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Card from '../../components/Card.astro';
import Button from '../../components/Button.astro';
import { professor, sources } from '../../data/professor';
import { areas } from '../../data/areas';

const trilha = await getCollection('trilha');
const bolsistas = await getCollection('bolsistas');
const glossario = (await getCollection('glossario')).sort((a, b) => a.data.degrau - b.data.degrau || a.data.termo.localeCompare(b.data.termo));

const resumo = areas.map((a) => ({
  area: a,
  degraus: trilha.filter((d) => d.data.area === a.id).length,
  atuais: bolsistas.filter((b) => b.data.area === a.id && b.data.status === 'atual').length,
}));
---

<Base title="Bolsistas" description="Área dos bolsistas: pesquisa, extensão e outros programas, cada um com a própria trilha de estudo, lista de bolsistas, glossário e como entrar no grupo.">
  <section class="section">
    <div class="container">
      <SectionHeading level="h1" eyebrow="Área dos orientandos" title="Três áreas, três trilhas" lead="Escolha a sua área. Cada uma tem uma trilha de estudo em degraus e a lista de quem já está lá. Quem chega agora começa pelo degrau 1; quem já está no grupo vai direto aos cartões dos colegas." />
      <div class="grid grid--3">
        {resumo.map(({ area, degraus, atuais }) => (
          <Card title={area.nome} href={`/bolsistas/${area.id}/`} tag={area.emConstrucao ? 'trilha em construção' : `${degraus} degraus`} linkLabel="Entrar">
            <p>{area.descricao}</p>
            <p class="caption">{atuais === 0 ? 'Nenhum bolsista cadastrado' : atuais === 1 ? '1 bolsista atual' : `${atuais} bolsistas atuais`} · {degraus} {degraus === 1 ? 'degrau' : 'degraus'} na trilha</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--band" aria-labelledby="trabalhe">
    <div class="container">
      <SectionHeading id="trabalhe" title="Como entrar no grupo" lead={professor.trabalheComigo.interesses} />
      <div class="grid grid--3">
        {professor.trabalheComigo.niveis.map((n) => (
          <Card title={n.nivel} tag="Oportunidade">
            <p>{n.oferta}.</p>
          </Card>
        ))}
        <Card title="O que se espera" tag="Perfil">
          <p>{professor.trabalheComigo.perfilEsperado}</p>
        </Card>
      </div>
      <div class="cluster" style="margin-top: var(--space-5)">
        <Button href={`mailto:${professor.email.valor}`} variant="primary">Escrever para o professor</Button>
        <Button href="/contato/" variant="secondary">Outras formas de contato</Button>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="glossario">
    <div class="container">
      <SectionHeading id="glossario" title="Glossário" lead="Termos usados nas trilhas, na ordem em que aparecem. Sigla entre parênteses quando existe." />
      <dl class="glossary">
        {glossario.map((g) => (
          <div class="glossary__item" id={`termo-${g.id}`}>
            <dt>
              {g.data.termo}{g.data.sigla && g.data.sigla !== g.data.termo ? ` (${g.data.sigla})` : ''}
              <span class="glossary__step">{g.data.area} · degrau {g.data.degrau}</span>
            </dt>
            <dd>{g.data.explicacao}</dd>
          </div>
        ))}
      </dl>
      <p class="caption" style="margin-top: var(--space-4)">
        Para adicionar um bolsista, copie <code>src/content/bolsistas/_modelo.md</code> no repositório do site; para um degrau novo, crie um arquivo em <code>src/content/trilha/&lt;area&gt;/</code>.
      </p>
    </div>
  </section>
</Base>

<style>
  .glossary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
  }
  .glossary__item {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-default);
  }
  .glossary__item dt {
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    align-items: baseline;
  }
  .glossary__step {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
    white-space: nowrap;
  }
  .glossary__item dd {
    margin: var(--space-1) 0 0;
    color: var(--color-text-secondary);
    font-size: calc(var(--text-body) - 2px);
  }
  @media (max-width: 767px) {
    .glossary {
      grid-template-columns: 1fr;
    }
  }
</style>
