---
/** Caixa de citação sem borda lateral (decisão do brandkit). */
interface Props {
  cite?: string;
  href?: string;
}
const { cite, href } = Astro.props;
---

<figure class="quote">
  <blockquote class="quote__text"><slot /></blockquote>
  {cite && (
    <figcaption class="quote__cite">
      {href ? <a href={href} rel="noopener">{cite}</a> : cite}
    </figcaption>
  )}
</figure>

<style>
  .quote {
    margin: 0;
    padding: var(--space-4);
    background: var(--color-quote-bg);
    color: var(--color-quote-text);
    border-radius: var(--radius-default);
  }
  .quote__text {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: calc(var(--text-body) + 2px);
    line-height: 1.5;
  }
  .quote__cite {
    margin-top: var(--space-2);
    font-size: var(--text-caption);
    opacity: 0.85;
  }
  .quote__cite a {
    color: inherit;
  }
</style>
