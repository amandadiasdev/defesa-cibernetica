---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Tag from '../components/Tag.astro';
import Button from '../components/Button.astro';
import { publicacoesDestaque, dataConferida } from '../data/publicacoes';
import { professor, sources } from '../data/professor';

const porAno = [...publicacoesDestaque].sort((a, b) => b.ano - a.ano || b.citacoes - a.citacoes);
---

<Base title="Publicações" description="Publicações em destaque do professor Silvio Quincozes, com links para a lista completa no Google Scholar, ORCID e Lattes.">
  <section class="section">
    <div class="container">
      <SectionHeading level="h1" eyebrow="Publicações" title="Trabalhos em destaque" lead={`Os cinco trabalhos mais citados do perfil do professor, com contagens de ${dataConferida}. A lista completa e sempre atualizada fica nos perfis abaixo.`} />
      <div class="cluster">
        <Button href={sources.scholar.url} variant="primary">Google Scholar</Button>
        <Button href={professor.perfis[1].url} variant="secondary">ORCID</Button>
        <Button href={professor.perfis[0].url} variant="secondary">Lattes</Button>
      </div>
    </div>
  </section>

  <section class="section section--band">
    <div class="container">
      <ol class="pubs">
        {porAno.map((p) => (
          <li class="pub">
            <div class="pub__year">{p.ano}</div>
            <div class="pub__body">
              <h3 class="pub__title">{p.titulo}</h3>
              {p.destaque && <p class="pub__note">{p.destaque}</p>}
              <div class="cluster">
                {p.tema.map((t) => <Tag>{t}</Tag>)}
                <span class="caption">{p.citacoes} citações em {dataConferida}</span>
              </div>
            </div>
          </li>
        ))}
      </ol>
      <p class="caption" style="margin-top: var(--space-4)">
        Métricas gerais em {professor.metricasScholar.data}: {professor.metricasScholar.citacoes} citações e índice h {professor.metricasScholar.indiceH}. {professor.metricasScholar.aviso}
      </p>
    </div>
  </section>
</Base>

<style>
  .pubs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .pub {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--color-bg-page);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-default);
  }
  .pub__year {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: var(--text-h2);
    line-height: 1;
  }
  .pub__title {
    font-size: calc(var(--text-body) + 2px);
    margin-bottom: var(--space-1);
  }
  .pub__note {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
  }
  @media (max-width: 599px) {
    .pub {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
