---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import Tag from '../components/Tag.astro';
import Button from '../components/Button.astro';
import Placeholder from '../components/Placeholder.astro';
import { professor, sources } from '../data/professor';
import { publicacoesDestaque } from '../data/publicacoes';
import { url } from '../lib/url';

const destaques = publicacoesDestaque.slice(0, 3);
const isPlaceholder = (v: string) => /^\{\{.*\}\}$/.test(v);
---

<Base title="Pesquisa" description="Pesquisa do professor Silvio Quincozes: cibersegurança e inteligência artificial aplicada, detecção de intrusões, explicabilidade, LLMs, educação e engenharia de software; extensão e projetos em andamento.">
  <section class="section">
    <div class="container">
      <SectionHeading level="h1" eyebrow={`Pesquisa · grupo ${professor.pesquisa.grupoNome}`} title="Cibersegurança e inteligência artificial aplicada" lead={professor.pesquisa.resumo} />
      <div class="cluster">
        {['Detecção de intrusão', 'Sistemas ciberfísicos', 'IEC 61850', 'IoT', 'XAI', 'LLMs', 'Educação 5.0', 'Engenharia de software'].map((c) => <Tag>{c}</Tag>)}
      </div>
    </div>
  </section>

  <section class="section section--band" aria-labelledby="temas">
    <div class="container">
      <SectionHeading id="temas" title="Temas de pesquisa" lead="Seis frentes que se combinam: dados, otimização e explicabilidade de modelos, aplicados a segurança, educação e software." />
      <div class="grid grid--3">
        {professor.pesquisa.temas.map((t, i) => (
          <Card title={t.nome} tag={`Tema ${i + 1}`}>
            <p>{t.descricao}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="extensao">
    <div class="container two-col">
      <div>
        <SectionHeading id="extensao" title="Extensão" lead={professor.extensao.resumo} />
        <div class="grid grid--2">
          {professor.extensao.iniciativas.map((i) => (
            <Card title={i.nome} href={isPlaceholder(i.url) ? undefined : i.url} linkLabel={isPlaceholder(i.url) ? undefined : 'Abrir'}>
              <p>{isPlaceholder(i.descricao) ? <Placeholder value={i.descricao} label="descrição a confirmar" /> : i.descricao}</p>
            </Card>
          ))}
          <Card title="Bolsistas de extensão">
            <p>Quem participa das ações de extensão tem trilha e lista próprias na área dos bolsistas.</p>
            <p><a href={url("/bolsistas/extensao/")}>Ver a área de extensão →</a></p>
          </Card>
        </div>
      </div>
      <div>
        <SectionHeading id="parcerias" title="Parcerias" />
        <ul class="partners">
          {professor.parcerias.valor.map((p) => <li>{p}</li>)}
        </ul>
        <h3 style="margin-top: var(--space-5)">Áreas declaradas</h3>
        <ul class="partners">
          {professor.areas.map((a) => <li>{a.nome}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--band" aria-labelledby="destaques">
    <div class="container">
      <SectionHeading id="destaques" title="Trabalhos em destaque" lead="Três dos trabalhos mais citados do professor." />
      <div class="grid grid--3">
        {destaques.map((p) => (
          <Card title={p.titulo} tag={String(p.ano)}>
            <p>{p.destaque}</p>
            <p class="caption">{p.citacoes} citações · {p.tema.join(' · ')}</p>
          </Card>
        ))}
      </div>
      <div class="cluster" style="margin-top: var(--space-5)">
        <Button href="/publicacoes/" variant="primary">Todas as publicações em destaque</Button>
        <Button href={sources.scholar.url} variant="link">Perfil no Google Scholar</Button>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="participar">
    <div class="container">
      <SectionHeading id="participar" title="Quer participar?" lead="Iniciação científica, extensão, TCC, mestrado e doutorado. A página dos bolsistas explica as trilhas e o que se espera de quem entra." />
      <Button href="/bolsistas/" variant="primary">Área dos bolsistas</Button>
    </div>
  </section>
</Base>

<style>
  .two-col {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-6);
  }
  .partners {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-2);
    display: grid;
    gap: var(--space-1);
  }
  .partners li {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-default);
  }
  @media (max-width: 767px) {
    .two-col {
      grid-template-columns: 1fr;
    }
  }
</style>
