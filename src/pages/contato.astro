---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import EmailCopy from '../components/EmailCopy.astro';
import { professor, sources } from '../data/professor';
import { grupo } from '../data/grupo';
---

<Base title="Contato" description="Como falar com o grupo Defesa Cibernética e com o coordenador: e-mail institucional, sala no campus Alegrete da Unipampa e Instagram.">
  <section class="section">
    <div class="container">
      <SectionHeading level="h1" eyebrow="Contato" title="Como falar com o grupo" lead="E-mail do coordenador para assuntos acadêmicos, sala para atendimento presencial e Instagram para acompanhar o grupo. Para marcar uma reunião, escreva por e-mail." />
      <div class="grid grid--3">
        <Card title="E-mail">
          <EmailCopy email={professor.email.valor} />
          <p class="caption">Use o e-mail institucional para orientação, disciplinas e propostas de pesquisa.</p>
        </Card>
        <Card title="Presencial">
          <p>{professor.sala.valor}</p>
          <p>Unipampa · {professor.campus.valor}</p>
          <p class="caption">Horário de atendimento: combine pelo chat institucional ou por e-mail.</p>
        </Card>
        {grupo.redes.map((r) => (
          <Card title={r.nome} href={r.url} linkLabel="Abrir">
            <p>{r.handle}</p>
            <p class="caption">Artigos, eventos, prêmios e pesquisadores do grupo.</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--band">
    <div class="container">
      <SectionHeading title="Perfis" lead="Publicações, currículo e redes." />
      <div class="cluster">
        {professor.perfis.map((p) => (
          <Button href={p.url} variant="secondary">{p.nome}</Button>
        ))}
      </div>
    </div>
  </section>
</Base>
